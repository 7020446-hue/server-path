# ==========================================
# ServerPath Explorer Configuration
# ==========================================

# Network & Server Settings
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Initial Exploration Path
# When left blank, automatically defaults to current workspace or system root
DEFAULT_PATH=
# Optional root directory to jail exploration to (leave blank for unrestricted system exploration)
EXPLORER_ROOT=

# Authentication Settings
# Set to 'false' to disable login gate (e.g. for private LAN, homelab, or trusted internal network)
REQUIRE_AUTH=true

# Local Administrator Credentials (used when offline or standalone)
ADMIN_USER=admin
ADMIN_PASSWORD=admin2009
ADMIN_EMAIL=admin@lootops.me

# External SSO / Auth Server (optional)
AUTH_SERVER_URL=https://server.lootops.me

# Set to 'false' in production if you don't want sample files created
CREATE_SAMPLE_DATA=false
